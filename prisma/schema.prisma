generator client {
  provider = "prisma-client-js"
}

// Connection strings live in prisma.config.ts (CLI/migrations) and
// src/lib/db.ts (runtime, via a driver adapter) -- Prisma 7 no longer
// reads them from the schema file.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

/// id matches the Supabase auth.users.id (uuid) -- Supabase remains the
/// credential/session source of truth, this table holds the app-facing
/// profile. Rows are lazily upserted on first authenticated request, see
/// src/lib/auth.ts.
model User {
  id        String   @id
  email     String   @unique
  name      String?
  company   String?
  bio       String?
  country   String?
  website   String?
  /// Default persona for UI purposes only -- a user can both buy and sell
  /// regardless of this value. Only ADMIN gates anything (the admin panel).
  role      Role     @default(BUYER)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets        Asset[]
  buyerRequests BuyerRequest[]
  inquiries     Inquiry[]
  offersMade    Offer[]         @relation("OfferBuyer")
  offersReceived Offer[]        @relation("OfferSeller")
  purchases     Transaction[]   @relation("TransactionBuyer")
  sales         Transaction[]   @relation("TransactionSeller")
  verifications Verification[]  @relation("VerifiedBy")
  bids          Bid[]
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

enum AssetType {
  DIGITAL_BUSINESS
  DOMAIN
  AI_AGENT
  DATASET
  API
  COMPUTE
}

enum AssetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

enum PricingType {
  FIXED
  NEGOTIABLE
  AUCTION
  MONTHLY
  HOURLY
  USAGE_BASED
}

enum VerificationSummary {
  UNVERIFIED
  PARTIAL
  VERIFIED
}

enum MoatType {
  PROMPT
  PROPRIETARY_DATA
  WORKFLOW
  DISTRIBUTION
  INTEGRATION
}

/// Generic asset model shared by every listing type. Fields specific to one
/// asset type (e.g. GPU model for COMPUTE, record count for DATASET) live in
/// `metadata` and are validated per-type with zod (src/lib/validation/asset.ts)
/// rather than as a per-type table -- keeps the schema simple for V1.
model Asset {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  assetType   AssetType
  status      AssetStatus @default(DRAFT)
  category    String?
  businessModel String?

  price        Decimal?    @db.Decimal(14, 2)
  currency     String      @default("USD")
  pricingType  PricingType @default(FIXED)

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  revenue        Decimal? @db.Decimal(14, 2)
  monthlyRevenue Decimal? @db.Decimal(14, 2)
  profit         Decimal? @db.Decimal(14, 2)
  monthlyProfit  Decimal? @db.Decimal(14, 2)
  growthRate     Decimal? @db.Decimal(6, 2)
  users          Int?
  customers      Int?
  traffic        Int?
  valuation      Decimal? @db.Decimal(14, 2)

  metadata Json @default("{}")

  verificationSummary VerificationSummary @default(UNVERIFIED)
  isSeedData          Boolean              @default(false)

  /// §2.4 -- when true, name/URL/screenshots are hidden on render, but metrics,
  /// category, Titer Score, Model Risk block and Proof of Function stay public.
  /// Never gated entirely and never excluded from the sitemap.
  confidential Boolean @default(false)

  /// §2.2 Model Risk block -- required for every AI_AGENT and any
  /// DIGITAL_BUSINESS with inference in COGS. All nullable: absence means
  /// "not applicable / not yet entered", rendered as such, never inferred.
  primaryModelProvider        String?
  fallbackProvider            String?
  inferenceCostPctOfRevenue   Decimal?  @db.Decimal(5, 2)
  grossMarginAt2xTokenPrice   Decimal?  @db.Decimal(5, 2)
  moatType                    MoatType?
  providerFeatureOverlapNotes String?
  /// One-line plain-English verdict, written by the scorer -- not computed.
  modelRiskVerdict            String?

  /// §4.3 "Transfer checklist" -- what literally moves, account by account.
  transferChecklist String?

  /// §4.2 marketplace card/filter -- founder time to run this, weekly. A real
  /// column (not metadata JSON) so it can be filtered and sorted directly.
  founderHoursPerWeek Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications Verification[]
  inquiries     Inquiry[]
  offers        Offer[]
  transactions  Transaction[]
  buyerRequestMatches BuyerRequest[] @relation("BuyerRequestAssetType")
  titerScore    TiterScore?
  proofRuns     ProofRun[]
  bidWindow     BidWindow?

  @@index([assetType, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Titer Score (§2.1)
// ---------------------------------------------------------------------------

/// Computed by a human against a published rubric and stored -- never inferred
/// or estimated by the app. An Asset with no row here renders "Unscored".
model TiterScore {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  total Int

  revenueDurability   Int // 0-25
  modelDependencyRisk Int // 0-25
  transferComplexity  Int // 0-20
  operationalLoad     Int // 0-15
  evidenceStrength    Int // 0-15

  rubricVersion String
  /// Short admin justification -- a bare number isn't credible, the breakdown is.
  justification String
  scoredBy      String
  scoredAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Proof of Function (§2.3)
// ---------------------------------------------------------------------------

model ProofRun {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  harnessVersion String
  requestCount   Int
  successRate    Decimal @db.Decimal(5, 2)
  p50Ms          Int
  p95Ms          Int
  costPerTaskUsd Decimal @db.Decimal(10, 4)
  errors         Json    @default("[]")
  ranAt          DateTime

  /// Private evidence -- never returned by any public-facing query.
  artifactUrl String?

  createdAt DateTime @default(now())

  @@index([assetId, ranAt])
}

// ---------------------------------------------------------------------------
// Open Bid (§2.5)
// ---------------------------------------------------------------------------

enum BidWindowStatus {
  OPEN
  CLOSED
}

model BidWindow {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  opensAt  DateTime @default(now())
  closesAt DateTime
  /// Private -- never returned by any public-facing query.
  reservePrice Decimal @db.Decimal(14, 2)
  status       BidWindowStatus @default(OPEN)

  bids Bid[]
}

model Bid {
  id          String    @id @default(cuid())
  bidWindowId String
  bidWindow   BidWindow @relation(fields: [bidWindowId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id])
  amount      Decimal   @db.Decimal(14, 2)
  placedAt    DateTime  @default(now())

  @@index([bidWindowId])
}

// ---------------------------------------------------------------------------
// Wind-down funnel (§2.7)
// ---------------------------------------------------------------------------

model WindDownLead {
  id             String   @id @default(cuid())
  url            String
  monthlyRevenue Decimal? @db.Decimal(14, 2)
  email          String
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Valuation tool (§2.8)
// ---------------------------------------------------------------------------

model ValuationLead {
  id               String    @id @default(cuid())
  assetType        AssetType
  mrr              Decimal   @db.Decimal(14, 2)
  momGrowth        Decimal?  @db.Decimal(6, 2)
  churn            Decimal?  @db.Decimal(6, 2)
  inferenceCostPct Decimal?  @db.Decimal(5, 2)
  email            String
  estimatedLow     Decimal   @db.Decimal(14, 2)
  estimatedHigh    Decimal   @db.Decimal(14, 2)
  provisionalGrade String
  createdAt        DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Titer Index comparables (§2.9)
// ---------------------------------------------------------------------------

enum ComparableSource {
  CLOSED_DEAL
  PUBLIC_COMP
}

model Comparable {
  id        String           @id @default(cuid())
  assetType AssetType
  sizeBand  String
  multiple  Decimal          @db.Decimal(6, 2)
  source    ComparableSource
  dealDate  DateTime?
  notes     String?
  createdAt DateTime         @default(now())

  @@index([assetType, sizeBand])
}

// ---------------------------------------------------------------------------
// Verification
// ---------------------------------------------------------------------------

enum VerificationType {
  REVENUE_VERIFIED
  TRAFFIC_VERIFIED
  OWNERSHIP_VERIFIED
  CUSTOMERS_VERIFIED
  TECHNOLOGY_VERIFIED
  IDENTITY_VERIFIED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// `evidence` stores a private object-storage key/URL -- never returned by
/// any public API, only rendered to the asset's seller and to admins.
model Verification {
  id         String             @id @default(cuid())
  assetId    String
  asset      Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type       VerificationType
  status     VerificationStatus @default(PENDING)
  evidence   String?
  verifiedById String?
  verifiedBy   User?            @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())

  @@unique([assetId, type])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Buyer requests & matching
// ---------------------------------------------------------------------------

enum BuyerRequestStatus {
  OPEN
  MATCHED
  CLOSED
}

model BuyerRequest {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  description  String
  assetType    AssetType?
  budgetMin    Decimal?            @db.Decimal(14, 2)
  budgetMax    Decimal?            @db.Decimal(14, 2)
  requirements String?
  status       BuyerRequestStatus  @default(OPEN)
  createdAt    DateTime            @default(now())

  /// Not a real FK -- kept only so Prisma generates a typed relation name
  /// used by the matching helper's includes; matching itself is computed
  /// on demand in src/lib/matching.ts, not persisted.
  matchedAssets Asset[] @relation("BuyerRequestAssetType")
}

// ---------------------------------------------------------------------------
// Inquiries ("Request Information")
// ---------------------------------------------------------------------------

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User          @relation(fields: [buyerId], references: [id])
  message   String?
  status    InquiryStatus @default(OPEN)
  createdAt DateTime      @default(now())

  @@index([assetId])
  @@index([buyerId])
}

// ---------------------------------------------------------------------------
// Offers
// ---------------------------------------------------------------------------

enum OfferStatus {
  SUBMITTED
  SELLER_REVIEW
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

model Offer {
  id           String      @id @default(cuid())
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User        @relation("OfferBuyer", fields: [buyerId], references: [id])
  sellerId     String
  seller       User        @relation("OfferSeller", fields: [sellerId], references: [id])
  offerPrice   Decimal     @db.Decimal(14, 2)
  counterPrice Decimal?    @db.Decimal(14, 2)
  currency     String      @default("USD")
  message      String?
  status       OfferStatus @default(SUBMITTED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transaction Transaction?

  @@index([assetId])
  @@index([buyerId])
  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// Transactions & commission
// ---------------------------------------------------------------------------

enum TransactionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Transaction {
  id               String            @id @default(cuid())
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id])
  offerId          String?           @unique
  offer            Offer?            @relation(fields: [offerId], references: [id])
  buyerId          String
  buyer            User              @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User              @relation("TransactionSeller", fields: [sellerId], references: [id])
  agreedPrice      Decimal           @db.Decimal(14, 2)
  commissionRate   Decimal           @db.Decimal(5, 2)
  commissionAmount Decimal           @db.Decimal(14, 2)
  sellerProceeds   Decimal           @db.Decimal(14, 2)
  status           TransactionStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([assetId])
  @@index([status])
}
