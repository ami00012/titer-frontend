NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma's data layer, pointed at the same Postgres instance Supabase
# provisions for auth -- get both from the Supabase project's Database
# settings. DATABASE_URL is the pooled (pgbouncer) connection used at
# runtime; DIRECT_URL is the direct connection `prisma migrate` needs
# (migrations can't run through a pooler). See DATABASE.md.
DATABASE_URL=
DIRECT_URL=

# Production domain, used for metadata/sitemap/OG absolute URLs (src/lib/brand.ts).
# Falls back to https://titer.dev if unset.
NEXT_PUBLIC_SITE_URL=

# Google OAuth client ID (Web application type). Public identifier, not a
# secret. Used for the client-side Sign in with Google flow, see
# src/components/auth/auth-form.tsx.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dev-only: skips real Supabase auth and treats every request as a logged-in
# admin. Ignored automatically in production builds regardless of this value
# (see src/lib/dev-bypass.ts).
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# secret — https://console.anthropic.com. Powers the "draft with AI" seller
# assistant (src/app/actions/listing-assistant.ts). Optional: when unset,
# the sell flow renders exactly as it did before -- no broken button, see
# src/app/(public)/sell/[type]/page.tsx.
ANTHROPIC_API_KEY=
