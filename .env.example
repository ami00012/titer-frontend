NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# Dev-only: skips real Supabase auth and treats every request as logged in
# as dev@titer.local. Ignored automatically in production builds regardless
# of this value (see src/lib/dev-bypass.ts).
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
